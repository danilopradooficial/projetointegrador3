<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(
  echo       = FALSE,   # o codigo NAO aparece: ele mora no notebook estrutura/codigo/aula01.ipynb
  message    = FALSE,
  warning    = FALSE,
  fig.align  = "center",
  out.width  = "0.52\\linewidth",
  fig.width  = 4,
  fig.height = 3.2
)
options(OutDec = ",", digits = 4)
