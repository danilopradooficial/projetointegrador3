<<dados, include=FALSE>>=
# REGRA: nada de acento dentro de string de R; acento so em LaTeX.
docs <- read.csv("entrega-1-docs.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
pag  <- read.csv("entrega-1-paginas.csv", stringsAsFactors = FALSE)
met  <- read.csv("entrega-1-metodos.csv", stringsAsFactors = FALSE)
rk   <- read.csv("entrega-1-rankings.csv", stringsAsFactors = FALSE)
jul  <- read.csv("entrega-1-julgamento.csv", stringsAsFactors = FALSE)
top  <- read.csv("entrega-1-top10.csv", fileEncoding = "UTF-8", stringsAsFactors = FALSE)
res  <- read.csv("entrega-1-resultados.csv")
r    <- setNames(res$valor, res$medida)

f1 <- function(x, d = 1) formatC(x, format = "f", digits = d, big.mark = ".", decimal.mark = ",")
f0 <- function(x) formatC(x, format = "d", big.mark = ".")

# texto do corpus entra no LaTeX com escape
tex <- function(x) {
  x <- gsub("\\\\", "\\\\textbackslash{}", x)
  x <- gsub("([%&_#$])", "\\\\\\1", x)
  x <- gsub("([{}])", "\\\\\\1", x)
  x <- gsub("~", "\\\\textasciitilde{}", x)
  x <- gsub("\\^", "\\\\textasciicircum{}", x)
  x
}
txt  <- setNames(docs$texto, docs$id)
tam  <- setNames(docs$n_tokens, docs$id)
cita <- function(id, n = 16) {
  p <- strsplit(txt[[id]], " ")[[1]]
  paste0("``", tex(paste(p[1:min(n, length(p))], collapse = " ")), if (length(p) > n) "\\ldots" else "", "''")
}

pag$pagina[pag$artigo == "d2"] <- "Autoridade Portu\\'aria"
pag$pagina[pag$artigo == "d3"] <- "Paula Ribeiro"
texto_pag <- paste0("\\textit{", pag$pagina, "} ", pag$frases, " (", pag$paragrafos, ")", collapse = "; ")
texto_top10 <- paste0("\\texttt{", tex(top$termo), "}", collapse = ", ")
n_tema      <- sum(top$termo %in% c("porto", "santos", "docas", "navios"))
longo_id    <- docs$id[docs$n_tokens > r[["longo"]]]

m  <- function(cq, me, col) met[met$consulta == cq & met$metodo == me, col]
nd <- function(cq, me) f1(m(cq, me, "ndcg"), 2)
ms.med <- tapply(met$ms, met$metodo, mean)
@

